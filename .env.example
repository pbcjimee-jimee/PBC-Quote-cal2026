NEXT_PUBLIC_SUPABASE_URL=
# Preferred current Supabase key name. A legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional local-only bypass. Leave unset/false when using Supabase auth and DB locally.
NEXT_PUBLIC_DEV_NO_AUTH=false

# Vercel Preview uses its own Supabase project and keys (never Production keys).
# VERCEL_ENV=preview is supplied by Vercel; do not override it in project settings.
# Preview builds reject Jobber credentials/callbacks and disable all Jobber calls.
# The allowed test project is documented in docs/DEPLOY.md.
# Optional additional login email allowlist (comma-separated).
# Blank skips this email filter in every environment; active user_profiles.is_active
# and the profile role remain the actual app access gate.
ALLOWED_LOGIN_EMAILS=

JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Required in every environment, including local development, before storing or
# refreshing Jobber tokens (DB and local file). Missing key fails closed.
# Jobber-disabled isolated Preview must leave Jobber configuration unset.
JOBBER_TOKEN_ENCRYPTION_KEY=
JOBBER_REDIRECT_URI=http://localhost:3000/api/jobber/callback
# Optional alias for JOBBER_REDIRECT_URI.
JOBBER_CALLBACK_URL=
# Optional. Defaults to 2025-04-16 when unset.
JOBBER_GRAPHQL_VERSION=2025-04-16
# Optional development fallback. Production quote fetch uses OAuth tokens stored in Supabase.
JOBBER_ACCESS_TOKEN=
